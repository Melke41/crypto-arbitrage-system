# Execution Mode: PAPER | TESTNET | LIVE (Must remain PAPER by default)
EXECUTION_MODE=PAPER
LIVE_TRADING_ENABLED=false

# Database (SQLite by default for local runs; PostgreSQL for production/Docker)
DATABASE_URL=sqlite+aiosqlite:///arbitrage_system.db
# DATABASE_URL=postgresql+asyncpg://arb_user:arb_pass@localhost:5432/crypto_arb

# Binance Spot Credentials (testnet.binance.vision by default)
BINANCE_API_KEY=your_binance_key_here
BINANCE_API_SECRET=your_binance_secret_here
BINANCE_USE_TESTNET=true

# Binance USDⓈ-M Futures Credentials (testnet.binancefuture.com)
# Separate key pair required for Futures Testnet (falls back to Spot key if unset)
BINANCE_FUTURES_API_KEY=your_binance_futures_key_here
BINANCE_FUTURES_API_SECRET=your_binance_futures_secret_here

# Kraken Spot Credentials
KRAKEN_API_KEY=your_kraken_key_here
KRAKEN_API_SECRET=your_kraken_secret_here
