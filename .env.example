# Execution Mode: PAPER | TESTNET | LIVE (Must remain PAPER by default)
EXECUTION_MODE=PAPER
LIVE_TRADING_ENABLED=false

# Database (PostgreSQL Async)
DATABASE_URL=postgresql+asyncpg://arb_user:arb_pass@localhost:5432/crypto_arb

# Binance Spot Credentials (Read-Only / Testnet by default)
BINANCE_API_KEY=your_binance_key_here
BINANCE_API_SECRET=your_binance_secret_here
BINANCE_USE_TESTNET=true

# Kraken Spot Credentials
KRAKEN_API_KEY=your_kraken_key_here
KRAKEN_API_SECRET=your_kraken_secret_here
